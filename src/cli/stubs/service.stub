use std::sync::Arc;
use crate::database::connection::DatabasePool;
use crate::app::models::{{snake_name}}::{{name}};
use crate::database::model::Model;

pub struct {{name}}Service {
    db: Arc<DatabasePool>,
}

impl {{name}}Service {
    pub fn new(db: Arc<DatabasePool>) -> Self {
        Self { db }
    }

    pub async fn all(&self) -> Result<Vec<{{name}}>, sqlx::Error> {
        {{name}}::all(&self.db).await
    }

    pub async fn find(&self, id: i64) -> Result<{{name}}, sqlx::Error> {
        {{name}}::find(&self.db, id).await
    }

    pub async fn create(&self, name: String) -> Result<i64, sqlx::Error> {
        let item = {{name}} { 
            id: 0, 
            name,
            // Tambahkan field lainnya
        };
        item.save(&self.db).await
    }

    pub async fn update(&self, id: i64, name: String) -> Result<bool, sqlx::Error> {
        sqlx::query("UPDATE {{table_name}} SET name = ? WHERE id = ?")
            .bind(name)
            .bind(id)
            .execute(&self.db.pool)
            .await?;
        Ok(true)
    }

    pub async fn delete(&self, id: i64) -> Result<bool, sqlx::Error> {
        {{name}}::delete(&self.db, id).await
    }
}
